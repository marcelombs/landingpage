# ======================================================================
# NUDO Landing Page — variables de entorno (EJEMPLO)
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.
# ======================================================================

# --- Aplicación ---
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de datos PostgreSQL ---
# En entorno local se usa el socket de Unix (/var/run/postgresql) con
# autenticación peer, o 127.0.0.1 con autenticación por contraseña.
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=nudo_landing
DB_USER=nudo_app
DB_PASSWORD=

# --- Contacto configurable (RF-06) ---
# Si WHATSAPP_ENABLED=false, los botones de WhatsApp muestran un aviso
# de demostración en lugar de un destino engañoso.
WHATSAPP_ENABLED=false
WHATSAPP_NUMBER=
WHATSAPP_MESSAGE_DEFAULT=Hola NUDO, vengo de la página web y quisiera hacer una consulta.

# --- Redes sociales (dejar vacío si no existen) ---
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# --- Correo de contacto (opcional) ---
CONTACT_EMAIL=
